#!/bin/sh
# Runs the view-concept command from this checkout, so an agent plugin needs no separate
# install: `uv` builds and caches the environment on first use.
root="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
if ! command -v uv >/dev/null 2>&1; then
  echo "view-concept needs uv: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 127
fi
cache="${XDG_CACHE_HOME:-$HOME/.cache}/view-concept/env-$(printf %s "$root" | cksum | cut -d' ' -f1)"
export UV_PROJECT_ENVIRONMENT="$cache"
exec uv run --quiet --project "$root" --no-dev view-concept "$@"
